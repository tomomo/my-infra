# --- ステージ1: 外部ツールの準備 ---
# ここは軽量な alpine 等で十分ですが、一貫性のため node イメージを活用します
FROM node:22-slim AS node-bins
# pnpmをここで準備してしまいます
RUN corepack enable && corepack prepare pnpm@latest --activate

# --- ステージ2: 実行用メインイメージ ---
FROM redhat/ubi9-minimal

ENV TZ=Asia/Tokyo \
    TERM=xterm-256color \
    COMPOSER_ALLOW_SUPERUSER=1

# 1. 外部バイナリのコピー
# composer, node, pnpm をこの時点で配置
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer
COPY --from=node-bins /usr/local/bin/node /usr/local/bin/node
COPY --from=node-bins /usr/local/bin/pnpm /usr/local/bin/pnpm
COPY --from=node-bins /usr/local/lib/node_modules /usr/local/lib/node_modules
# pnpm の実体へのシンボリックリンク調整（必要に応じて）
RUN ln -s /usr/local/lib/node_modules/corepack/dist/pnpm.js /usr/local/bin/pnpm-corepack || true

# 2. OSパッケージインストールと設定（1レイヤーで完結）
# curl ではなく tar/gzip を先にいれつつ、rpmを直接ダウンロード・インストール
RUN microdnf install -y tar gzip \
    && curl -LO https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm \
    && curl -LO https://rpms.remirepo.net/enterprise/remi-release-9.rpm \
    && rpm -i --nosignature epel-release-latest-9.noarch.rpm remi-release-9.rpm \
    && microdnf module enable php:remi-8.4 -y \
    && microdnf install -y \
       php-cli php-fpm php-intl php-mbstring php-xml php-zip php-gd php-mysqlnd \
       php-opcache php-imap php-pgsql \
       tzdata git git-lfs unzip procps-ng vim-minimal findutils shadow-utils libstdc++ \
       --setopt=install_weak_deps=0 --nodocs \
    && microdnf clean all \
    && rm -rf epel-release-latest-9.noarch.rpm remi-release-9.rpm /var/cache/yum /var/cache/dnf \
    # タイムゾーン設定
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    # PHP-FPM設定
    && mkdir -p /run/php-fpm && chmod 777 /run/php-fpm \
    && sed -i 's/listen = \/run\/php-fpm\/www.sock/listen = 9000/' /etc/php-fpm.d/www.conf \
    && sed -i 's/listen.allowed_clients = 127.0.0.1/;listen.allowed_clients = 127.0.0.1/' /etc/php-fpm.d/www.conf \
    && sed -i 's/;security.limit_extensions = .php .php3 .php4 .php5 .php7/security.limit_extensions = .php .html/' /etc/php-fpm.d/www.conf

# 3. ターミナル設定
RUN { \
    echo 'export PS1="\[\e[1;32m\]\u@\h\[\e[m\]:\[\e[1;36m\]\W\[\e[1;32m\]\\$ \[\e[m\]"'; \
    echo "alias ls='ls --color=auto'"; \
    echo "alias ll='ls -l --color=auto'"; \
    echo "alias grep='grep --color=auto'"; \
    } > /etc/profile.d/custom_terminal.sh

WORKDIR /app
CMD ["php-fpm", "-F"]
